generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String     @id @default(uuid())
  name          String?
  email         String     @unique
  password      String
  role          String     @default("USER") // USER, ADMIN
  plan          String     @default("FREE") // FREE, PRO, ENTERPRISE
  maxRestaurants Int       @default(1)
  emailVerified Boolean   @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  restaurants         UserRestaurant[]
  ownedRestaurants    Restaurant[]
  verificationTokens  VerificationToken[]
  passwordResetTokens PasswordResetToken[]

  @@index([email])
}

model Restaurant {
  id            String      @id @default(uuid())
  name          String
  slug          String      @unique
  ownerId       String
  owner         User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  bgColor       String      @default("#0a0a0a")
  menuTitleColor String     @default("#f59e0b")
  searchBgColor  String     @default("#171717")
  searchBtnColor String     @default("#262626")
  searchBtnTextColor String @default("#ededed")
  cardBgColor    String     @default("#171717")
  cardTitleColor String     @default("#ededed")
  cardDescColor  String     @default("#a3a3a3")
  cardPriceColor String     @default("#f59e0b")
  cardBtnColor   String     @default("#f59e0b")
  cardBtnTextColor String   @default("#0a0a0a")
  users         UserRestaurant[]
  categories    Category[]
  products      Product[]
  orders        Order[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model UserRestaurant {
  id            String     @id @default(uuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  role          String     @default("ADMIN") // OWNER, ADMIN, STAFF
  createdAt     DateTime   @default(now())

  @@unique([userId, restaurantId])
  @@index([userId])
  @@index([restaurantId])
}

model Category {
  id           String     @id @default(uuid())
  name         String
  order        Int        @default(0)
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  products     Product[]
  createdAt    DateTime   @default(now())

  @@index([restaurantId])
}

model Product {
  id           String      @id @default(uuid())
  name         String
  description  String?
  price        Float
  imageUrl     String?
  available    Boolean     @default(true)
  order        Int         @default(0)
  categoryId   String
  category     Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  restaurantId String
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orderItems   OrderItem[]
  createdAt    DateTime    @default(now())

  @@index([categoryId])
  @@index([restaurantId])
}

model Order {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  customerName  String?
  customerPhone String?
  customerEmail String?
  total         Float
  status        String  @default("pending")

  items     OrderItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([restaurantId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
  notes     String?
}

model VerificationToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([token])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([token])
}
